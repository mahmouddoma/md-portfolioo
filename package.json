{
  "name": "doma-portfolio",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:gh": "ng build --base-href /md-portfolioo/",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "~22.2.4",
    "@angular/compiler": "~22.2.4",
    "@angular/core": "~22.2.4",
    "@angular/platform-browser": "~22.2.4",
    "@angular/platform-server": "~22.2.4",
    "@angular/router": "~22.2.4",
    "@angular/ssr": "~22.2.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "~22.2.5",
    "@angular/cli": "~22.2.5",
    "@angular/compiler-cli": "~22.2.4",
    "jsdom": "^27.1.0",
    "typescript": "~6.0.0",
    "vitest": "^4.0.8"
  }
}
